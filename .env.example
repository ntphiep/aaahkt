# AWS Environment Variables (do not commit actual values)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Kestra Configuration
KESTRA_URL=http://localhost:8080
KESTRA_API_KEY=your_kestra_api_key
KESTRA_NAMESPACE=dev.aws.pipeline

# AWS Services
CLOUDWATCH_LOG_GROUP=/aws/lambda/pipeline
S3_BUCKET=aws-devops-pipeline-logs
DYNAMODB_TABLE=pipeline-state

# Oumi RL Configuration
RL_MODEL_PATH=./models/rl_agent
RL_TRAINING_ENABLED=true
RL_LEARNING_RATE=0.001

# Pipeline Configuration
ANOMALY_THRESHOLD=0.8
AUTO_ROLLBACK_ENABLED=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
